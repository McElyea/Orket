{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orket.dev/schemas/governed_agent_loop_v1.json",
  "title": "Orket Governed Agent Loop V1 Wire Contracts",
  "oneOf": [
    { "$ref": "#/$defs/submission" },
    { "$ref": "#/$defs/iterationRequest" },
    { "$ref": "#/$defs/iterationResult" },
    { "$ref": "#/$defs/modelProfileRequest" },
    { "$ref": "#/$defs/modelCallRequest" },
    { "$ref": "#/$defs/modelCallResult" },
    { "$ref": "#/$defs/modelUseReceipt" },
    { "$ref": "#/$defs/memoryQueryRequest" },
    { "$ref": "#/$defs/memoryQueryResult" },
    { "$ref": "#/$defs/effectProposal" },
    { "$ref": "#/$defs/progress" },
    { "$ref": "#/$defs/usage" },
    { "$ref": "#/$defs/cancellation" },
    { "$ref": "#/$defs/brokerFrame" }
  ],
  "$defs": {
    "nonEmptyToken": { "type": "string", "minLength": 1, "maxLength": 256 },
    "reference": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "referenceList": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reference" }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id", "attempt_id", "iteration_ordinal", "step_id", "trace_id",
        "invocation_id", "fencing_generation"
      ],
      "properties": {
        "run_id": { "$ref": "#/$defs/nonEmptyToken" },
        "attempt_id": { "$ref": "#/$defs/nonEmptyToken" },
        "iteration_ordinal": { "type": "integer", "minimum": 1 },
        "step_id": { "$ref": "#/$defs/nonEmptyToken" },
        "trace_id": { "$ref": "#/$defs/nonEmptyToken" },
        "invocation_id": { "$ref": "#/$defs/nonEmptyToken" },
        "fencing_generation": { "type": "integer", "minimum": 1 }
      }
    },
    "roleCounter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "count"],
      "properties": {
        "role": { "type": "string", "minLength": 1, "maxLength": 64 },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "capabilityCounter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "count"],
      "properties": {
        "capability": { "$ref": "#/$defs/nonEmptyToken" },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "snapshot_ref", "snapshot_digest", "scope",
        "iterations", "wall_time_ms", "model_calls", "per_role_model_calls",
        "input_tokens", "output_tokens", "effect_proposals",
        "per_capability_effects", "output_bytes", "artifact_bytes",
        "repair_attempts", "consecutive_failures", "repeated_states",
        "no_progress_iterations", "total_inference_concurrency",
        "per_role_inference_concurrency"
      ],
      "properties": {
        "schema_version": { "const": "agent_budget_snapshot.v1" },
        "snapshot_ref": { "$ref": "#/$defs/reference" },
        "snapshot_digest": { "$ref": "#/$defs/digest" },
        "scope": { "enum": ["run_limit", "iteration_limit", "run_remaining", "iteration_remaining"] },
        "iterations": { "type": "integer", "minimum": 0 },
        "wall_time_ms": { "type": "integer", "minimum": 0 },
        "model_calls": { "type": "integer", "minimum": 0 },
        "per_role_model_calls": {
          "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/roleCounter" }
        },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "effect_proposals": { "type": "integer", "minimum": 0 },
        "per_capability_effects": {
          "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/capabilityCounter" }
        },
        "output_bytes": { "type": "integer", "minimum": 0 },
        "artifact_bytes": { "type": "integer", "minimum": 0 },
        "repair_attempts": { "type": "integer", "minimum": 0 },
        "consecutive_failures": { "type": "integer", "minimum": 0 },
        "repeated_states": { "type": "integer", "minimum": 0 },
        "no_progress_iterations": { "type": "integer", "minimum": 0 },
        "total_inference_concurrency": { "type": "integer", "minimum": 0 },
        "per_role_inference_concurrency": {
          "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/roleCounter" }
        }
      }
    },
    "materializedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference", "kind", "media_type", "encoding", "digest", "encoded_bytes",
        "content", "provenance_refs"
      ],
      "properties": {
        "reference": { "$ref": "#/$defs/reference" },
        "kind": {
          "enum": ["objective", "acceptance", "authoritative_context", "prior_verified_output"]
        },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "encoding": { "enum": ["utf8", "json", "base64"] },
        "digest": { "$ref": "#/$defs/digest" },
        "encoded_bytes": { "type": "integer", "minimum": 0, "maximum": 262144 },
        "content": {},
        "provenance_refs": { "$ref": "#/$defs/referenceList" }
      },
      "allOf": [
        {
          "if": { "properties": { "encoding": { "enum": ["utf8", "base64"] } } },
          "then": { "properties": { "content": { "type": "string" } } }
        }
      ]
    },
    "modelProfileRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type", "schema_version", "role", "max_input_tokens",
        "max_output_tokens", "timeout_ms", "response_mode", "streaming_preference"
      ],
      "properties": {
        "object_type": { "const": "agent_model_profile_request" },
        "schema_version": { "const": "agent_model_profile_request.v1" },
        "role": { "type": "string", "minLength": 1, "maxLength": 64 },
        "profile_ref": { "$ref": "#/$defs/reference" },
        "capability_class": { "type": "string", "minLength": 1, "maxLength": 128 },
        "max_input_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "response_mode": { "enum": ["text", "json"] },
        "streaming_preference": { "enum": ["disabled", "preferred", "required"] }
      },
      "oneOf": [
        { "required": ["profile_ref"], "not": { "required": ["capability_class"] } },
        { "required": ["capability_class"], "not": { "required": ["profile_ref"] } }
      ]
    },
    "modelMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["system", "user", "assistant", "tool"] },
        "content": { "type": "string", "maxLength": 131072 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "toolDescription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "input_schema"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyToken" },
        "description": { "type": "string", "maxLength": 4096 },
        "input_schema": { "type": "object", "maxProperties": 64 }
      }
    },
    "modelCallRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type", "schema_version", "identity", "call_id", "role", "messages",
        "response_mode", "max_input_tokens", "max_output_tokens", "timeout_ms",
        "streaming_preference", "tool_descriptions", "stop_sequences"
      ],
      "properties": {
        "object_type": { "const": "agent_model_call_request" },
        "schema_version": { "const": "agent_model_call_request.v1" },
        "identity": { "$ref": "#/$defs/identity" },
        "call_id": { "$ref": "#/$defs/nonEmptyToken" },
        "role": { "type": "string", "minLength": 1, "maxLength": 64 },
        "profile_ref": { "$ref": "#/$defs/reference" },
        "capability_class": { "type": "string", "minLength": 1, "maxLength": 128 },
        "messages": {
          "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/modelMessage" }
        },
        "response_mode": { "enum": ["text", "json"] },
        "response_schema": { "type": "object", "maxProperties": 128 },
        "max_input_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "seed": { "type": "integer" },
        "streaming_preference": { "enum": ["disabled", "preferred", "required"] },
        "tool_descriptions": {
          "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/toolDescription" }
        },
        "stop_sequences": {
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      },
      "oneOf": [
        { "required": ["profile_ref"], "not": { "required": ["capability_class"] } },
        { "required": ["capability_class"], "not": { "required": ["profile_ref"] } }
      ],
      "allOf": [
        {
          "if": { "properties": { "response_mode": { "const": "json" } } },
          "then": { "required": ["response_schema"] }
        }
      ]
    },
    "modelUseReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type", "schema_version", "identity", "call_id", "role",
        "requested_profile_ref", "resolved_profile_ref", "provider", "provider_version",
        "model", "model_digest", "status", "usage_posture", "input_tokens",
        "output_tokens", "estimate_source", "charged_input_tokens",
        "charged_output_tokens", "latency_ms", "finish_reason", "truncated",
        "substitution_posture"
      ],
      "properties": {
        "object_type": { "const": "agent_model_use_receipt" },
        "schema_version": { "const": "agent_model_use_receipt.v1" },
        "identity": { "$ref": "#/$defs/identity" },
        "call_id": { "$ref": "#/$defs/nonEmptyToken" },
        "role": { "type": "string", "minLength": 1, "maxLength": 64 },
        "requested_profile_ref": { "$ref": "#/$defs/reference" },
        "resolved_profile_ref": { "$ref": "#/$defs/reference" },
        "provider": { "$ref": "#/$defs/nonEmptyToken" },
        "provider_version": { "type": ["string", "null"], "maxLength": 256 },
        "model": { "$ref": "#/$defs/reference" },
        "model_digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "status": { "enum": ["returned", "failed", "cancelled", "timed_out", "uncertain"] },
        "usage_posture": { "enum": ["measured", "estimated", "unknown"] },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "estimate_source": { "type": ["string", "null"], "maxLength": 256 },
        "charged_input_tokens": { "type": "integer", "minimum": 0 },
        "charged_output_tokens": { "type": "integer", "minimum": 0 },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "finish_reason": { "type": ["string", "null"], "maxLength": 128 },
        "truncated": { "type": "boolean" },
        "substitution_posture": { "enum": ["requested", "substituted", "degraded"] }
      },
      "allOf": [
        {
          "if": { "properties": { "usage_posture": { "enum": ["measured", "estimated"] } } },
          "then": {
            "properties": {
              "input_tokens": { "type": "integer", "minimum": 0 },
              "output_tokens": { "type": "integer", "minimum": 0 }
            }
          }
        },
        {
          "if": { "properties": { "usage_posture": { "const": "estimated" } } },
          "then": { "properties": { "estimate_source": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "usage_posture": { "const": "unknown" } } },
          "then": {
            "properties": {
              "input_tokens": { "type": "null" },
              "output_tokens": { "type": "null" },
              "estimate_source": { "type": "null" }
            }
          }
        }
      ]
    },
    "modelCallResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type", "schema_version", "identity", "call_id", "role",
        "response", "response_digest", "receipt", "normalized_reason"
      ],
      "properties": {
        "object_type": { "const": "agent_model_call_result" },
        "schema_version": { "const": "agent_model_call_result.v1" },
        "identity": { "$ref": "#/$defs/identity" },
        "call_id": { "$ref": "#/$defs/nonEmptyToken" },
        "role": { "type": "string", "minLength": 1, "maxLength": 64 },
        "response": { "type": ["string", "object", "array", "null"] },
        "response_digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "receipt": { "$ref": "#/$defs/modelUseReceipt" },
        "normalized_reason": { "type": ["string", "null"], "maxLength": 2048 }
      }
    },
    "memoryQueryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type", "schema_version", "identity", "call_id", "scope", "role",
        "query", "max_items", "max_content_bytes"
      ],
      "properties": {
        "object_type": { "const": "agent_memory_query_request" },
        "schema_version": { "const": "agent_memory_query_request.v1" },
        "identity": { "$ref": "#/$defs/identity" },
        "call_id": { "$ref": "#/$defs/nonEmptyToken" },
        "scope": { "enum": ["extension_private", "role_private", "team_shared", "objective"] },
        "role": { "type": ["string", "null"], "maxLength": 64 },
        "query": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "max_items": { "type": "integer", "minimum": 1, "maximum": 128 },
        "max_content_bytes": { "type": "integer", "minimum": 1, "maximum": 262144 }
      }
    },
    "memoryQueryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type", "schema_version", "identity", "call_id", "status", "entries", "normalized_reason"
      ],
      "properties": {
        "object_type": { "const": "agent_memory_query_result" },
        "schema_version": { "const": "agent_memory_query_result.v1" },
        "identity": { "$ref": "#/$defs/identity" },
        "call_id": { "$ref": "#/$defs/nonEmptyToken" },
        "status": { "enum": ["returned", "blocked", "failed", "cancelled"] },
        "entries": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reference", "content", "content_digest", "provenance_refs"],
            "properties": {
              "reference": { "$ref": "#/$defs/reference" },
              "content": {},
              "content_digest": { "$ref": "#/$defs/digest" },
              "provenance_refs": { "$ref": "#/$defs/referenceList" }
            }
          }
        },
        "normalized_reason": { "type": ["string", "null"], "maxLength": 2048 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["blocked", "failed", "cancelled"] } } },
          "then": { "properties": { "normalized_reason": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "effectProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type", "schema_version", "identity", "proposal_id", "capability",
        "intended_target", "namespace", "arguments_digest", "idempotency_key", "evidence_refs"
      ],
      "properties": {
        "object_type": { "const": "agent_effect_proposal" },
        "schema_version": { "const": "agent_effect_proposal.v1" },
        "identity": { "$ref": "#/$defs/identity" },
        "proposal_id": { "$ref": "#/$defs/nonEmptyToken" },
        "capability": { "$ref": "#/$defs/nonEmptyToken" },
        "intended_target": { "$ref": "#/$defs/reference" },
        "namespace": { "$ref": "#/$defs/reference" },
        "arguments": { "type": "object", "maxProperties": 64 },
        "arguments_ref": { "$ref": "#/$defs/reference" },
        "arguments_digest": { "$ref": "#/$defs/digest" },
        "idempotency_key": { "$ref": "#/$defs/nonEmptyToken" },
        "evidence_refs": { "$ref": "#/$defs/referenceList" }
      },
      "oneOf": [
        { "required": ["arguments"], "not": { "required": ["arguments_ref"] } },
        { "required": ["arguments_ref"], "not": { "required": ["arguments"] } }
      ]
    },
    "effectReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id", "proposal_id", "identity", "capability", "intended_target",
        "arguments_digest", "state", "authority_ref", "observation_refs"
      ],
      "properties": {
        "receipt_id": { "$ref": "#/$defs/nonEmptyToken" },
        "proposal_id": { "$ref": "#/$defs/nonEmptyToken" },
        "identity": { "$ref": "#/$defs/identity" },
        "capability": { "$ref": "#/$defs/nonEmptyToken" },
        "intended_target": { "$ref": "#/$defs/reference" },
        "arguments_digest": { "$ref": "#/$defs/digest" },
        "state": {
          "enum": ["proposed", "approved", "denied", "executed", "observed", "uncertain", "reconciled"]
        },
        "authority_ref": { "$ref": "#/$defs/reference" },
        "observation_refs": { "$ref": "#/$defs/referenceList" }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "schema_version", "identity", "sequence", "summary", "evidence_refs"],
      "properties": {
        "object_type": { "const": "agent_progress" },
        "schema_version": { "const": "agent_progress.v1" },
        "identity": { "$ref": "#/$defs/identity" },
        "sequence": { "type": "integer", "minimum": 1 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "evidence_refs": { "$ref": "#/$defs/referenceList" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type", "schema_version", "model_calls", "usage_posture", "input_tokens",
        "output_tokens", "estimate_source", "charged_input_tokens", "charged_output_tokens",
        "effect_proposals", "output_bytes", "artifact_bytes", "repair_attempts"
      ],
      "properties": {
        "object_type": { "const": "agent_usage" },
        "schema_version": { "const": "agent_usage.v1" },
        "model_calls": { "type": "integer", "minimum": 0 },
        "usage_posture": { "enum": ["measured", "estimated", "unknown"] },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "estimate_source": { "type": ["string", "null"], "maxLength": 256 },
        "charged_input_tokens": { "type": "integer", "minimum": 0 },
        "charged_output_tokens": { "type": "integer", "minimum": 0 },
        "effect_proposals": { "type": "integer", "minimum": 0 },
        "output_bytes": { "type": "integer", "minimum": 0 },
        "artifact_bytes": { "type": "integer", "minimum": 0 },
        "repair_attempts": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "usage_posture": { "enum": ["measured", "estimated"] } } },
          "then": {
            "properties": {
              "input_tokens": { "type": "integer", "minimum": 0 },
              "output_tokens": { "type": "integer", "minimum": 0 }
            }
          }
        },
        {
          "if": { "properties": { "usage_posture": { "const": "estimated" } } },
          "then": { "properties": { "estimate_source": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "usage_posture": { "const": "unknown" } } },
          "then": {
            "properties": {
              "input_tokens": { "type": "null" },
              "output_tokens": { "type": "null" },
              "estimate_source": { "type": "null" }
            }
          }
        }
      ]
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "schema_version", "requested", "cancellation_epoch"],
      "properties": {
        "object_type": { "const": "agent_cancellation" },
        "schema_version": { "const": "agent_cancellation.v1" },
        "requested": { "type": "boolean" },
        "cancellation_epoch": { "type": "integer", "minimum": 0 },
        "reason": { "type": ["string", "null"], "maxLength": 1024 }
      }
    },
    "handoffProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity", "handoff_id", "source_role", "target_role", "target_profile_ref",
        "scope", "artifact_refs", "provenance_refs", "requested_capabilities",
        "requested_model_calls", "requested_input_tokens", "requested_output_tokens"
      ],
      "properties": {
        "identity": { "$ref": "#/$defs/identity" },
        "handoff_id": { "$ref": "#/$defs/nonEmptyToken" },
        "source_role": { "type": "string", "minLength": 1, "maxLength": 64 },
        "target_role": { "type": "string", "minLength": 1, "maxLength": 64 },
        "target_profile_ref": { "$ref": "#/$defs/reference" },
        "scope": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "artifact_refs": { "$ref": "#/$defs/referenceList" },
        "provenance_refs": { "$ref": "#/$defs/referenceList" },
        "requested_capabilities": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyToken" }
        },
        "requested_model_calls": { "type": "integer", "minimum": 0 },
        "requested_input_tokens": { "type": "integer", "minimum": 0 },
        "requested_output_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "memoryWriteProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity", "proposal_id", "scope", "role", "content", "content_digest",
        "provenance_refs", "evidence_refs"
      ],
      "properties": {
        "identity": { "$ref": "#/$defs/identity" },
        "proposal_id": { "$ref": "#/$defs/nonEmptyToken" },
        "scope": { "enum": ["extension_private", "role_private", "team_shared", "objective"] },
        "role": { "type": ["string", "null"], "maxLength": 64 },
        "content": {},
        "content_digest": { "$ref": "#/$defs/digest" },
        "provenance_refs": { "$ref": "#/$defs/referenceList" },
        "evidence_refs": { "$ref": "#/$defs/referenceList" }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type", "schema_version", "objective_ref", "acceptance_ref",
        "initial_context_refs", "extension_id", "workload_id", "agent_contract_version",
        "allowed_capabilities", "namespace_scope", "policy_ref", "policy_digest",
        "policy_schema_version", "run_budget", "iteration_budget", "verifier_class",
        "verifier_config", "requested_model_profiles", "recovery_posture", "operator_ref"
      ],
      "properties": {
        "object_type": { "const": "governed_agent_submission" },
        "schema_version": { "const": "governed_agent_submission.v1" },
        "objective_ref": { "$ref": "#/$defs/reference" },
        "acceptance_ref": { "$ref": "#/$defs/reference" },
        "initial_context_refs": { "$ref": "#/$defs/referenceList" },
        "extension_id": { "$ref": "#/$defs/nonEmptyToken" },
        "workload_id": { "const": "governed-agent-loop" },
        "agent_contract_version": { "const": "governed_agent_loop.v1" },
        "allowed_capabilities": {
          "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyToken" }, "contains": { "const": "agent.iteration.v1" }
        },
        "namespace_scope": {
          "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
          "items": { "$ref": "#/$defs/reference" }
        },
        "policy_ref": { "$ref": "#/$defs/reference" },
        "policy_digest": { "$ref": "#/$defs/digest" },
        "policy_schema_version": { "$ref": "#/$defs/nonEmptyToken" },
        "run_budget": { "$ref": "#/$defs/budget" },
        "iteration_budget": { "$ref": "#/$defs/budget" },
        "verifier_class": { "$ref": "#/$defs/nonEmptyToken" },
        "verifier_config": { "type": "object", "maxProperties": 64 },
        "requested_model_profiles": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": { "$ref": "#/$defs/modelProfileRequest" }
        },
        "recovery_posture": { "enum": ["fail_closed", "operator_required"] },
        "operator_ref": { "$ref": "#/$defs/reference" }
      }
    },
    "iterationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type", "schema_version", "identity", "objective_ref", "acceptance_ref",
        "authoritative_context_refs", "prior_verified_output_refs", "materialized_inputs",
        "effect_receipts", "admitted_capabilities", "namespace_scope", "model_profiles",
        "policy_ref", "policy_digest", "remaining_run_budget", "remaining_iteration_budget",
        "deadline_utc", "lease_expires_at_utc", "cancellation", "extension_config"
      ],
      "properties": {
        "object_type": { "const": "agent_iteration_request" },
        "schema_version": { "const": "agent_iteration_request.v1" },
        "identity": { "$ref": "#/$defs/identity" },
        "objective_ref": { "$ref": "#/$defs/reference" },
        "acceptance_ref": { "$ref": "#/$defs/reference" },
        "authoritative_context_refs": { "$ref": "#/$defs/referenceList" },
        "prior_verified_output_refs": { "$ref": "#/$defs/referenceList" },
        "materialized_inputs": {
          "type": "array", "minItems": 2, "maxItems": 258,
          "items": { "$ref": "#/$defs/materializedInput" }
        },
        "effect_receipts": {
          "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/effectReceipt" }
        },
        "admitted_capabilities": {
          "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyToken" }, "contains": { "const": "agent.iteration.v1" }
        },
        "namespace_scope": {
          "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
          "items": { "$ref": "#/$defs/reference" }
        },
        "model_profiles": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": { "$ref": "#/$defs/modelProfileRequest" }
        },
        "policy_ref": { "$ref": "#/$defs/reference" },
        "policy_digest": { "$ref": "#/$defs/digest" },
        "remaining_run_budget": { "$ref": "#/$defs/budget" },
        "remaining_iteration_budget": { "$ref": "#/$defs/budget" },
        "deadline_utc": { "type": "string", "format": "date-time" },
        "lease_expires_at_utc": { "type": "string", "format": "date-time" },
        "accepted_checkpoint_ref": { "type": ["string", "null"], "maxLength": 1024 },
        "recovery_ref": { "type": ["string", "null"], "maxLength": 1024 },
        "cancellation": { "$ref": "#/$defs/cancellation" },
        "extension_config": { "type": "object", "maxProperties": 64 }
      }
    },
    "iterationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type", "schema_version", "identity", "invocation_status", "observations",
        "effect_proposals", "progress_claims", "completion_recommendation",
        "completion_evidence_refs", "handoff_proposals", "memory_write_proposals",
        "model_receipts", "usage", "normalized_reason"
      ],
      "properties": {
        "object_type": { "const": "agent_iteration_result" },
        "schema_version": { "const": "agent_iteration_result.v1" },
        "identity": { "$ref": "#/$defs/identity" },
        "invocation_status": { "enum": ["returned", "blocked", "failed", "cancelled"] },
        "observations": {
          "type": "array", "maxItems": 256,
          "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
        },
        "advisory_proposal": { "type": ["string", "null"], "maxLength": 65536 },
        "advisory_proposal_ref": { "type": ["string", "null"], "maxLength": 1024 },
        "effect_proposals": {
          "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/effectProposal" }
        },
        "progress_claims": {
          "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/progress" }
        },
        "completion_recommendation": { "enum": ["continue", "pause", "stop", "complete"] },
        "completion_evidence_refs": { "$ref": "#/$defs/referenceList" },
        "handoff_proposals": {
          "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/handoffProposal" }
        },
        "memory_write_proposals": {
          "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/memoryWriteProposal" }
        },
        "model_receipts": {
          "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/modelUseReceipt" }
        },
        "usage": { "$ref": "#/$defs/usage" },
        "normalized_reason": { "type": ["string", "null"], "maxLength": 2048 }
      },
      "allOf": [
        {
          "if": { "properties": { "invocation_status": { "enum": ["blocked", "failed", "cancelled"] } } },
          "then": { "properties": { "normalized_reason": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "brokerFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type", "schema_version", "protocol_version", "invocation_id", "sequence",
        "direction", "message_type", "call_id", "operation", "payload"
      ],
      "properties": {
        "object_type": { "const": "agent_stdio_frame" },
        "schema_version": { "const": "agent_stdio_frame.v1" },
        "protocol_version": { "const": "agent_stdio_ipc.v1" },
        "invocation_id": { "$ref": "#/$defs/nonEmptyToken" },
        "sequence": { "type": "integer", "minimum": 1 },
        "direction": { "enum": ["parent_to_child", "child_to_parent"] },
        "message_type": {
          "enum": ["bootstrap", "ready", "capability_call", "capability_result", "progress", "iteration_result", "cancel"]
        },
        "call_id": { "type": ["string", "null"], "maxLength": 256 },
        "operation": { "enum": [null, "model.call.v1", "memory.query.v1"] },
        "payload": { "type": "object" }
      }
    }
  }
}
