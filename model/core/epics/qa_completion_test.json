{
  "id": "qa_completion_test",
  "name": "qa_completion_test",
  "description": "Prepared integer-sum CLI workflow; use examples/stored_workflows/prepare.py.",
  "team": "standard",
  "environment": "standard",
  "architecture_governance": {
    "idesign": false,
    "pattern": "Tactical"
  },
  "issues": [
    {
      "id": "QA-01",
      "summary": "Validate the prepared sum CLI",
      "seat": "code_reviewer",
      "status": "ready",
      "depends_on": [],
      "note": "Inspect the seeded CLI. Request mechanical verification against six declared cases. A faulty implementation must remain unaccepted. Read the required inputs, use write_file for changes, then update_issue_status to code_review. The runtime verifies acceptance; do not claim to have run shell commands.",
      "params": {
        "completion_acceptance": {
          "schema_version": "card_python_cli_acceptance.v1",
          "acceptance_ref": "QA-01.v1",
          "policy_ref": "integer-sum-cli.v1",
          "workload_id": "QA-01",
          "entrypoint": "agent_output/main.py",
          "artifact_paths": [
            "agent_output/main.py"
          ],
          "cases": [
            {
              "criterion_id": "zero",
              "description": "zero",
              "arguments": [
                "0",
                "0"
              ],
              "expected_json": "0"
            },
            {
              "criterion_id": "positive",
              "description": "positive",
              "arguments": [
                "2",
                "3"
              ],
              "expected_json": "5"
            },
            {
              "criterion_id": "negative",
              "description": "negative",
              "arguments": [
                "-7",
                "4"
              ],
              "expected_json": "-3"
            },
            {
              "criterion_id": "both-negative",
              "description": "both-negative",
              "arguments": [
                "-2",
                "-3"
              ],
              "expected_json": "-5"
            },
            {
              "criterion_id": "large",
              "description": "large",
              "arguments": [
                "12345678901234567890",
                "1"
              ],
              "expected_json": "12345678901234567891"
            },
            {
              "criterion_id": "padding",
              "description": "padding",
              "arguments": [
                " 2 ",
                "3"
              ],
              "expected_json": "5"
            }
          ]
        },
        "cards_runtime": {
          "execution_profile": "write_artifact_v1",
          "artifact_contract": {
            "kind": "artifact",
            "primary_output": "agent_output/main.py",
            "required_read_paths": [
              "agent_output/requirements.txt",
              "agent_output/main.py"
            ],
            "required_write_paths": [],
            "review_read_paths": [
              "agent_output/requirements.txt",
              "agent_output/main.py"
            ]
          }
        },
        "turn_contract": {
          "required_action_tools": [
            "update_issue_status"
          ],
          "required_read_paths": [
            "agent_output/requirements.txt",
            "agent_output/main.py"
          ],
          "required_write_paths": [],
          "required_statuses": [
            "code_review"
          ]
        }
      }
    },
    {
      "id": "QA-02",
      "summary": "Retain a scoped QA handoff",
      "seat": "coder",
      "status": "ready",
      "depends_on": [
        "QA-01"
      ],
      "note": "Write agent_output/qa_handoff.json as exactly this JSON object: {\"scope\":\"six-declared-cases\",\"implementation\":\"agent_output/main.py\",\"exhaustive\":false}. The earlier card executes the CLI cases. This card retains only their explicit review scope. Read the required inputs, use write_file for changes, then update_issue_status to code_review. The runtime verifies acceptance; do not claim to have run shell commands.",
      "params": {
        "completion_acceptance": {
          "schema_version": "card_artifact_acceptance.v1",
          "acceptance_ref": "QA-02.v1",
          "policy_ref": "integer-sum-design.v1",
          "workload_id": "QA-02",
          "artifact_paths": [
            "agent_output/qa_handoff.json"
          ],
          "cases": [
            {
              "kind": "json_value_equals",
              "criterion_id": "design",
              "description": "Declared structured contract",
              "path": "agent_output/qa_handoff.json",
              "key_path": [],
              "expected_json": "{\"scope\": \"six-declared-cases\", \"implementation\": \"agent_output/main.py\", \"exhaustive\": false}"
            }
          ]
        },
        "cards_runtime": {
          "execution_profile": "write_artifact_v1",
          "artifact_contract": {
            "kind": "artifact",
            "primary_output": "agent_output/qa_handoff.json",
            "required_read_paths": [
              "agent_output/requirements.txt",
              "agent_output/main.py"
            ],
            "required_write_paths": [
              "agent_output/qa_handoff.json"
            ],
            "review_read_paths": [
              "agent_output/requirements.txt",
              "agent_output/main.py",
              "agent_output/qa_handoff.json"
            ]
          }
        },
        "turn_contract": {
          "required_action_tools": [
            "write_file",
            "update_issue_status"
          ],
          "required_read_paths": [
            "agent_output/requirements.txt",
            "agent_output/main.py"
          ],
          "required_write_paths": [
            "agent_output/qa_handoff.json"
          ],
          "required_statuses": [
            "code_review"
          ]
        }
      }
    }
  ]
}
